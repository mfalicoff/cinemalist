<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core packages -->
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.MongoDB" Version="13.6.5" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Bun" Version="13.3.0" />
    <PackageVersion Include="Mazilious.Common" Version="0.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.21.0" />
    <!-- MongoDB packages -->
    <PackageVersion Include="MongoDB.Bson" Version="3.14.0" />
    <PackageVersion Include="MongoDB.Driver" Version="3.14.0" />
    <!-- HTML parsing -->
    <PackageVersion Include="HtmlAgilityPack" Version="1.13.1" />
    <!-- Resilience -->
    <PackageVersion Include="TMDbLib" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>
</Project>
